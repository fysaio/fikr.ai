# Supabase (Online Project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LLM / Groq (OpenAI-compatible)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-or-openai-api-key
LLM_MODEL=llama-3.3-70b-versatile

# Cron security
CRON_SECRET=your-cron-secret-here

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Development Fixtures
NEXT_PUBLIC_USE_FIXTURES=false

# AI gateway
# Daily token cap per user across all AI tasks (reserve-then-settle, enforced in Postgres).
AI_DAILY_TOKENS_PER_USER=60000
# Fallback providers (e.g. additional Groq accounts or Gemini). Used in sequence when primary fails or rate-limits.
# Account 2 (Backup 1):
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
# Account 3 (Backup 2):
LLM_FALLBACK_2_API_KEY=
LLM_FALLBACK_2_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_2_MODEL=llama-3.1-8b-instant
# Operator routes (/api/metrics, /api/test-llm, /api/run-acceptance-tests) are 404 in production without this header value.
ADMIN_SECRET=

# Nudges (push)
# VAPID public key is also set above. Subject is a mailto: or https URL.
VAPID_SUBJECT=mailto:you@example.com
# Vercel Cron sends this as a Bearer token to /api/cron/nudges. Without it the route returns 503.
CRON_SECRET=
