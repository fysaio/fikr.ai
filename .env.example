# Supabase (Online Project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LLM / Groq (OpenAI-compatible)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-or-openai-api-key
LLM_MODEL=llama-3.3-70b-versatile

# Cron security
CRON_SECRET=your-cron-secret-here

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Development Fixtures
NEXT_PUBLIC_USE_FIXTURES=false

# AI gateway
# Daily token cap per user across all AI tasks (reserve-then-settle, enforced in Postgres).
AI_DAILY_TOKENS_PER_USER=60000
# Fallback provider (Gemini via its OpenAI-compatible endpoint). Used when the primary fails or returns invalid output.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_MODEL=gemini-2.5-flash
# Operator routes (/api/metrics, /api/test-llm, /api/run-acceptance-tests) are 404 in production without this header value.
ADMIN_SECRET=
